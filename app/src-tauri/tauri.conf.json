{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LitLoop",
  "version": "1.18.5",
  "identifier": "cc.litloop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LitLoop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": [
          "zh-CN"
        ],
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp",
        "template": "wix/main.wxs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "litloop"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEM0M1QUIxNTI0Mzk3NkEKUldScWwwTlNzVm84emFTams2VE43Sjh5L2g4c3lLRkw3RHR2aWgwTHY1T0ZiWk1LcldhenZGa0MK",
      "endpoints": [
        "https://github.com/dysprosium231/litloop-paper-agent/releases/latest/download/latest.json"
      ]
    }
  }
}
